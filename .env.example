# En local : garder tel quel (SQLite, fichier local)
DATABASE_URL="file:./dev.db"

# En production sur Vercel : remplacer par l'URL Postgres fournie par Neon ou Supabase
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clé secrète pour signer les sessions — génère une vraie valeur aléatoire en production
# (ex: openssl rand -base64 32)
SESSION_SECRET="change-moi-en-production"

# Clé API Resend, pour l'envoi des emails (confirmation, facture, demande d'avis).
# Sans cette variable, les emails sont simplement ignorés (avec un avertissement en log).
# RESEND_API_KEY="re_..."

# URL publique du site, utilisée dans les liens des emails. Optionnel en local.
# SITE_URL="https://houblon-chez-toi-kohl.vercel.app"

# Clés Stripe, pour le paiement par carte des comptes pro (Checkout).
# Sans STRIPE_SECRET_KEY, le paiement par carte est simplement indisponible (message d'erreur propre côté client).
# STRIPE_SECRET_KEY="sk_test_..."
# Secret de signature du webhook Stripe (Développeurs > Webhooks > endpoint /api/stripe/webhook > checkout.session.completed)
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Bot Telegram admin (notifications commandes/paiements/avis/comptes pro).
# Créé via @BotFather sur Telegram. Sans TELEGRAM_BOT_TOKEN, les notifications sont ignorées.
# TELEGRAM_BOT_TOKEN="123456:ABC-..."
# Code secret que toi seul connais, à envoyer une fois via "/start <code>" au bot pour t'enregistrer comme destinataire.
# TELEGRAM_SETUP_CODE="choisis-un-code-secret"
