// Schéma de base de données — Houblon chez toi
// En local : SQLite (fichier). En production (Vercel) : remplacer le provider
// par "postgresql" et DATABASE_URL par l'URL Neon/Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  accountType  String   @default("PARTICULIER") // "PARTICULIER" ou "PROFESSIONNEL"
  companyName  String?
  town         String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Beer {
  id       String  @id @default(cuid())
  name     String
  brewery  String
  origin   String  // ville / région
  country  String  // "FR" ou "BE"
  abv      Float
  price33  Float
  price75  Float
  depositCents33 Int @default(0) // consigne bouteille 33cl
  depositCents75 Int @default(0) // consigne bouteille 75cl
  description String
  tastingNote String? // notre avis de dégustation, affiché sur la fiche produit
  appearance String? // robe
  aroma      String? // nez
  taste      String? // bouche
  servingTemp String? // température de service conseillée
  foodPairing String? // accords mets-bière
  brewHistory String? // histoire de la brasserie / de la recette, pour la fiche complète
  active   Boolean @default(true)
  bottleImageUrl String?
  learnMoreUrl String? // page officielle de la brasserie
  shortHistory String? // courte histoire pour la mise en avant "bière du mois"
  isBeerOfMonth Boolean @default(false)
  glasses    Glass[]
  orderItems OrderItem[]
  depositReturns DepositReturn[]
  baskets    Basket[] @relation("BasketBeers")
}

model Basket {
  id          String  @id @default(cuid())
  name        String  @default("Le panier de la quinzaine")
  description String?
  priceCents  Int     @default(0)
  active      Boolean @default(false) // inactif tant qu'aucun prix n'est fixé
  beers       Beer[]  @relation("BasketBeers")
}

model MerchProduct {
  id          String  @id @default(cuid())
  name        String
  description String?
  priceCents  Int     @default(0)
  imageUrl    String?
  active      Boolean @default(false) // inactif tant qu'aucun prix n'est fixé
}

model Glass {
  id       String  @id @default(cuid())
  beer     Beer    @relation(fields: [beerId], references: [id])
  beerId   String
  name     String
  volumeCl Int
  price    Float
  imageUrl String?
  orderItems OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  status    String      @default("EN_PREPARATION") // EN_PREPARATION, EN_LIVRAISON, LIVREE, ANNULEE
  town      String
  pickup    Boolean     @default(false) // retrait sur place à Bondues au lieu d'une livraison
  slot      String      // ex: "Jeudi 14 août, 18h-19h"
  itemsTotalCents Int   @default(0) // sous-total hors livraison
  deliveryFeeCents Int  @default(0)
  depositChargedCents Int @default(0) // consignes facturées sur cette commande
  depositReturnedCents Int @default(0) // consignes recréditées (reprise de bouteilles)
  totalCents Int
  createdAt DateTime    @default(now())
  reviewToken String    @unique @default(cuid()) // lien sécurisé pour l'email de demande d'avis
  items     OrderItem[]
  depositReturns DepositReturn[]
  extras    OrderExtra[]
  review    Review?
}

model OrderExtra {
  id        String @id @default(cuid())
  order     Order  @relation(fields: [orderId], references: [id])
  orderId   String
  kind      String // "basket" ou "merch"
  refId     String // id du Basket ou du MerchProduct au moment de l'achat
  name      String // nom figé au moment de l'achat
  quantity  Int
  unitPriceCents Int
  lineTotalCents Int
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  beer      Beer    @relation(fields: [beerId], references: [id])
  beerId    String
  format    Int     // 33 ou 75
  quantity  Int
  glass     Glass?  @relation(fields: [glassId], references: [id])
  glassId   String?
  unitPriceCents Int
  depositCents Int @default(0) // consigne facturée pour cette ligne (unitaire × quantité)
}

model Review {
  id           String   @id @default(cuid())
  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String   @unique
  customerName String
  rating       Int      // 1 à 5
  comment      String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model DepositReturn {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id])
  orderId String
  beer    Beer   @relation(fields: [beerId], references: [id])
  beerId  String
  format  Int    // 33 ou 75
  quantity Int
  creditedCents Int
}
